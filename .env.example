# vtms-e2e 환경 설정. 복사해서 .env.local 로 만들고 값을 채운다.
#   cp .env.example .env.local

# 테스트 대상 VTMS 웹 앱 주소.
# 로컬: (../vtms 에서) 프로덕션 빌드 후 정적 서버로 서빙. README.md 참고.
# 라이브 서버 검증 시에만 http://www.logistics.ai.kr 로 바꾼다.
BASE_URL=http://localhost:3000

# e2e 전용 테스트 계정 (Firebase Auth + VTMS 백엔드에 실제로 로그인 가능해야 함)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# VTMS 백엔드 API 주소 (마스터 CRUD 테스트의 데이터 정리용 — UI 삭제가 아니라
# 백엔드 API를 직접 호출해 정리한다. 알려진 이슈는 README 참고).
# 로컬: 프론트와 다른 오리진(별도 포트)이라 명시적으로 채워야 한다.
# 라이브 서버: 프론트와 같은 오리진에서 서빙되므로 BASE_URL과 동일하게 둔다.
API_BASE_URL=http://localhost:8000
