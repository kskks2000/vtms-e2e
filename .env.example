# vtms-e2e 환경 설정. 복사해서 .env.local 로 만들고 값을 채운다.
#   cp .env.example .env.local

# 테스트 대상 VTMS 웹 앱 주소.
# 로컬: (../vtms 에서) API_BASE_URL 주입 없이 프로덕션 빌드 후, 백엔드가 그 번들을
# 같은 오리진에서 서빙한다(FRONTEND_DIST). README.md 참고.
# 라이브 서버 검증 시에만 http://www.logistics.ai.kr 로 바꾼다.
BASE_URL=http://127.0.0.1:8000

# e2e 전용 테스트 계정 (Firebase Auth + VTMS 백엔드에 실제로 로그인 가능해야 함)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# VTMS 백엔드 API 주소 (마스터 CRUD 테스트의 데이터 정리용 — UI 삭제가 아니라
# 백엔드 API를 직접 호출해 정리한다. 알려진 이슈는 README 참고).
# 로컬·라이브 모두 프론트와 같은 오리진에서 서빙되므로 BASE_URL과 동일하게 둔다.
# (별도 포트로 프론트를 서빙하는 구성을 쓸 때만 서로 다른 값이 된다.)
API_BASE_URL=http://127.0.0.1:8000
